{
  "name": "armor-lab",
  "productName": "ArmorLab",
  "version": "1.5.0",
  "license": "MIT",
  "description": "穿甲實驗室：終端彈道模擬",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "page": "node build-local.js",
    "start": "node build-local.js && electron .",
    "dist": "node build-local.js && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.armorlab.game",
    "productName": "ArmorLab",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "electron/**",
      "play.html",
      "*.js",
      "!build-local.js",
      "lib/**",
      "assets/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "穿甲實驗室"
    },
    "portable": {
      "artifactName": "ArmorLab-Portable-${version}.exe"
    }
  }
}